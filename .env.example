APP_NAME=Sprint Sarthi
ENV=local
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI mode
# mock = local deterministic agent behavior with no paid APIs
# openai-compatible = calls OPENAI_BASE_URL chat completions if OPENAI_API_KEY is set
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60

# Jira mode
JIRA_MOCK_MODE=true
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SS
