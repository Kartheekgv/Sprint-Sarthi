{
  "name": "sprint-sarthi-pro",
  "private": true,
  "version": "3.0.0",
  "description": "A responsive sprint planning dashboard built with React, TypeScript, and Vite.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --open",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty",
    "preview": "vite preview --host 0.0.0.0 --open",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "lucide-react": "^0.540.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  }
}
